{
  "functions": {
    "api/api-live.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api-live/public/question/:path*",
      "destination": "https://data.apnibus.com/public/question/:path*"
    },
    {
      "source": "/api-live/api/public/card/:path*",
      "destination": "https://data.apnibus.com/api/public/card/:path*"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
